---
import "../styles/global.css";
import Main from "../layouts/Main.astro";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#1a1e24" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favico.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Red+Rose:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <script
      is:inline
      data-astro-rerun
      src="https://kit.fontawesome.com/76e9aa395c.js"
      crossorigin="anonymous"></script>
    <meta name="generator" content={Astro.generator} />
    <title>Wolf's Den</title>
  </head>
  <body class="text-body">
    <Main transition:persist>
      <slot />
    </Main>
  </body>
</html>

<style>
  html {
    color-scheme: dark;
    background-color: var(--color-primary);
  }

  html,
  body {
    min-height: -webkit-fill-available;
    height: 100dvh;
    margin: 0;
    padding-bottom: env(safe-area-inset-bottom);
    overflow: hidden;
    background: url("/cave-bg.jpg") center / cover no-repeat;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
</style>
