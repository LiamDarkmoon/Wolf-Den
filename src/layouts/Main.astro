<div id="container" class="text-main-text">
	<main>
		<slot/>
	</main>
</div>

<style>
	#container {
		position: relative;
		background: url('/den-bg.webp') center/cover no-repeat;
		background-color: #f2af23;
		height: 100%;
		width: 100%;
		max-width: 100%;
		display: grid;
		/* grid-template-columns: 150px 1fr;
		grid-template-rows: 100px 1fr 100px; */
	}
	#container::before {
		content: "";
		position: absolute;
		inset: 0;
		background-color: #10141ba7;
		
	}

	main {
		position: relative;
		z-index: 1;
		min-height: 100vh;
		width: 100%;
		padding-inline: 1.5rem;
		display: flex;
		justify-content: center;
	}

</style>
