---
import NavBar from "../components/NavBar.astro";
---

<div id="container" class="text-main-text">
  <NavBar />
  <main class="scrollbar-none">
    <slot />
  </main>
</div>

<style>
  #container {
    position: relative;
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;

    overflow: hidden;
  }
  #container::before {
    content: "";
    position: fixed;
    inset: 0;
    background-color: #10141ba7;
    z-index: 0;
  }

  #container > * {
    position: relative;
    z-index: 1;
  }

  main {
    flex-grow: 1;
    position: relative;
    display: flex;
    flex-direction: column;

    min-width: 0;
    min-height: 0;

    padding: 1.25rem;

    overflow-y: auto;
    overflow-x: hidden;
  }
</style>
