---
import NavBar from "../components/NavBar.astro";
---

<div id="container" class="text-main-text">
  <NavBar />
  <main class="scrollbar-none">
    <slot />
  </main>
</div>

<style>
  #container {
  position: relative;
  background: url("/cave-bg.jpg") center / cover no-repeat;

  width: 100%;
  height: 100dvh;
  max-height: 100dvh;

  display: grid;
  grid-template-columns: 1fr;
  grid-template-rows: 54px minmax(0, 1fr);

  overflow: hidden;
}
  #container::before {
    content: "";
    position: absolute;
    inset: 0;
    max-height: 100dvh;
    background-color: #10141ba7;
  }

  main {
  grid-column: 1 / -1;
  grid-row: 2;

  position: relative;
  z-index: 1;

  display: flex;
  flex-direction: column;

  width: 100%;
  min-width: 0;
  min-height: 0;

  padding: 1.25rem;

  overflow-y: auto;
  overflow-x: hidden;
}
</style>
