---
import NavBar from "../components/NavBar.astro";
---

<div id="container" class="text-main-text">
  <NavBar />
  <main class="scrollbar-none">
    <slot />
  </main>
</div>

<style>
  #container {
    position: fixed;
    inset: 0;

    display: flex;
    flex-direction: column;
    /* grid-template-columns: 1fr;
    grid-template-rows: 54px minmax(0, 1fr); */

    /* background: url("/cave-bg.jpg") center / cover no-repeat; */

    overflow: hidden;
  }
  #container::before {
    content: "";
    position: absolute;
    inset: 0;

    background-color: #10141ba7;
  }

  main {
    grid-column: 1 / -1;
    grid-row: 2;

    position: relative;

    display: flex;
    flex-direction: column;

    min-width: 0;
    min-height: 0;
   

    padding: 1.25rem;

    overflow-y: auto;
    overflow-x: hidden;
  }
</style>