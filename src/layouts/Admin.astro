---
import Layout from './Layout.astro';

const path = Astro.url.pathname;

---
<Layout>
    <h1 class="text-2xl text-center font-bold border-b-2 border-primary mb-4 pb-4">
        <i class="fa-solid fa-layer-group me-1"></i>
        Panel de administracion
    </h1>
    <section class="h-full flex flex-col md:flex-row gap-4 overflow-hidden scrollbar-none">
       
        <div class="md:w-1/4 flex md:flex-col gap-4 py-4 md:border-e-2 border-primary">
            <a 
                class={path === "/admin/adventures" ? "w-full text-center md:text-start mb-2 p-2 rounded-sm border-b border-primary/40 bg-primary/20" : "w-full text-center md:text-start mb-2 p-2 rounded-sm border-b group border-primary/40"}
                href="/admin/adventures"
            >
            <i class={path === "/admin/adventures" ? "fa-solid fa-map-location-dot me-2 text-primary" : "fa-solid fa-map-location-dot me-2 group-hover:text-primary"}></i>
                Aventuras
            </a>
            <a 
                class={path === "/admin/players" ? "w-full text-center md:text-start mb-2 p-2 rounded-sm border-b border-primary/40 bg-primary/20" : "w-full text-center md:text-start mb-2 p-2 rounded-sm border-b group border-primary/40"}
                href="/admin/players"
            >
            <i class={path === "/admin/players" ? "fa-solid fa-file-lines me-2 text-primary" : "fa-solid fa-file-lines me-2 group-hover:text-primary"}></i>
                Jugadores
            </a>
            {
                path !== "/admin" && (
                    <a 
                        class={"w-full text-center md:text-start mb-2 p-2 rounded-sm border-b border-primary/40 hover:text-primary"}
                        href="/admin"
                    >
                        <i class="fa-solid fa-house me-2"></i>
                        Dashboard
                    </a>
                )
            }
        </div>
        <div class="w-full overflow-y-auto scrollbar-none">
            <slot/>
        </div>

    </section>
</Layout>

<style>

</style>