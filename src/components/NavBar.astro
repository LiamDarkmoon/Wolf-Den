---
const user = Astro.locals.user;
const profilePicture = user?.user_metadata?.profile_picture || null;

const userRole = Astro.locals.userRole;
---
<nav class="py-3 px-6 flex justify-between items-center text-primary z-100 transition-all duration-300 cursor-pointer">
    <a href="/" class="font-black italic">
        Wolf's Den
    </a>
    {
    user ? (
            <div class="flex gap-6 items-center font-black italic hover:text-primary-hover">
                {
                    (userRole === 'admin' || userRole === 'super_admin') && (
                        <div>
                            <a
                                href="/admin"
                                class="font-bold ms-auto hover:text-primary-hover"
                            >
                                <i class="fa-solid fa-users-gear"></i>
                                
                            </a>
                        </div>
                    )
                }
                <a
                    class="flex gap-2 items-center font-black italic hover:text-primary-hover"
                    href={`/profile/${user.id}`}
                >
                    <span class="hidden md:block">
                        {user.user_metadata?.full_name}
                    </span>
                    {
                        userRole === 'admin'
                            ? <i class="fa-solid fa-user-gear" />
                            : userRole === 'super_admin'
                                ? <i class="fa-solid fa-user-shield" />
                                : <i class="fa-solid fa-user" />
                    }
                </a>
            </div>
        ) : (
            <a
                href="/auth/login"
                class="font-bold ms-auto hover:text-primary-hover"
            >
                LogIn
                <i class="fa-solid fa-right-to-bracket ms-1"></i>
            </a>
        )
    }
</nav>