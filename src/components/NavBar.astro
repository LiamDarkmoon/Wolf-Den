---
import AdminButton from "./AdminButton";

const user = Astro.locals.user;
const profilePicture = user?.user_metadata?.profile_picture || null;

const userRole = Astro.locals.userRole;
---
<nav class="py-3 px-6 flex justify-between items-center text-primary z-100  cursor-pointer">
    <a href="/" class="font-black italic hover:text-primary-hover transition-all duration-300">
        Wolf's Den
    </a>
    <AdminButton role={userRole} />
    {
    user ? (
            <div class="flex justify-end items-center">
                <a
                    class="flex gap-2 items-center font-black italic hover:text-primary-hover transition-all duration-300"
                    href={`/profile/${user.id}`}
                >
                    <span class="">
                        {user.user_metadata?.full_name.trim().split(/\s+/)[0]}
                    </span>
                    {
                        userRole === 'admin'
                            ? <i class="fa-solid fa-user-gear" />
                            : userRole === 'super_admin'
                                ? <i class="fa-solid fa-user-shield" />
                                : <i class="fa-solid fa-user" />
                    }
                </a>
            </div>
        ) : (
            <a
                href="/auth/login"
                class="font-bold ms-auto hover:text-primary-hover transition-all duration-300"
            >
                LogIn
                <i class="fa-solid fa-right-to-bracket ms-1"></i>
            </a>
        )
    }
</nav>