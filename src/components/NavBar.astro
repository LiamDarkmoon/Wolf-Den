---
const user = Astro.locals.user;
const profilePicture = user?.user_metadata?.profile_picture || null;
---
<nav class="py-3 px-6 flex justify-between items-center text-primary z-100 transition-all duration-300 cursor-pointer">
    <a href="/" class="font-black italic">
        Wolf's Den
    </a>
    {
        user ? (
                
                <div class="flex gap-2 items-center font-black italic hover:text-primary-hover">
                    <a  
                        class="flex gap-2 items-center font-black italic hover:text-primary-hover"
                        href={`/profile/${user?.user_metadata?.full_name}`}
                    >
                        <span class="hidden md:block">
                            {user?.user_metadata?.full_name}
                        </span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                            <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </div>
            ) : (
                <a href="/auth/login" class="font-bold ms-auto hover:text-primary-hover ">
                LogIn
            </a>
        )
    }
</nav>