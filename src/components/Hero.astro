---
import Button from './button.tsx';
---

<div class="hero max-h-162.5">
    <h1 class="text-3xl font-bold text-center mt-12.5">Bienvenidos a <br/> <span class="text-5xl text-primary">Wolf's Den</span></h1>
    <p class="text-lg italic opacity-80 my-7.5">Una forma rapida y sencilla de adentrarte en el mundo de D&D.</p>
    
    <div class="flex flex-col  justify-center items-center gap-3">
        <Button client:load  to="/characters/creation">Crea tu personaje</Button>
        <!-- <Button className="">Crea un objeto</Button> -->
    </div>

    <a href="/adventures/league" class="text-primary hover:text-primary font-bold py-2 px-4"> Liga de aventureros </a>
</div>

<style>
    .hero {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        text-align: center;
    }
</style>