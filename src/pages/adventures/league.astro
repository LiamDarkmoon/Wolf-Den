---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/button.tsx';
---
<Layout>
    <div class="w-full md:w-1/2 flex flex-col items-center justify-center gap-4 py-4">
        <h1 class="text-3xl font-bold text-center mb-4">Liga de Aventureros -LMDR-</h1>
        <p class="text-center text-secondary-text">Bienvenido a la liga, aca podes ver el tablon y elegir tu mision</p>
        
        <section class="w-full flex flex-col items-center justify-center gap-4">
            <h2 class="flex gap-2 items-center text-xl font-bold text-center mb-4 text-primary-hover">
                Tablero de Misiones
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                    <path fill-rule="evenodd" d="M11.47 13.28a.75.75 0 0 0 1.06 0l7.5-7.5a.75.75 0 0 0-1.06-1.06L12 11.69 5.03 4.72a.75.75 0 0 0-1.06 1.06l7.5 7.5Z" clip-rule="evenodd" />
                    <path fill-rule="evenodd" d="M11.47 19.28a.75.75 0 0 0 1.06 0l7.5-7.5a.75.75 0 1 0-1.06-1.06L12 17.69l-6.97-6.97a.75.75 0 0 0-1.06 1.06l7.5 7.5Z" clip-rule="evenodd" />
                </svg>
            </h2>
            <article class="board">
                <h2 class="text-2xl font-bold text-center mb-4 text-primary-hover underline">El ultimo santuario</h2>
                <img src="/last-sanctum.png" alt="Descripción de la mision" class="w-full object-cover mb-4 rounded">
                <Button client:load to="/adventures/league/mission-details">Unirse a la mision</Button> 
            </article>
        </section>
    </div>
</Layout>

<style>
    .board {
        display: flex;
        flex-direction: column;
        width: 100%;
        min-height: 60vh;
        background-image: url('/wood-bg.jpg');
        background-size: cover;
        padding: 2rem;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);

    }
</style>