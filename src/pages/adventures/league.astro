---
import Layout from '../../layouts/Layout.astro';
import { getAdventuresWithStatus } from '../../lib/utils/getAdventuresWithStatus';
import type { adventureWithStatus } from '../../lib/types';
import AdventureCardsList from '../../components/AdventureCardsList';

const role = Astro.locals.userRole;
const adventures:adventureWithStatus[] = await getAdventuresWithStatus({
    request: Astro.request,
    cookies: Astro.cookies,
    filter: "upcoming"
})

---
<Layout>
    <section class="w-full flex flex-col items-center justify-center gap-4 py-4 h-full overflow-hidden">
        <h1 class="flex gap-2 items-center text-2xl font-bold text-center border-b-2 border-primary pb-4">
            TABLERO DE MISIONES
            <i class="fa-solid fa-arrow-down-short-wide"></i>
        </h1>
        <AdventureCardsList adventures={adventures} role={role} client:only="react"/>
    </section>
</Layout>