---
import Layout from '../../layouts/Layout.astro';
import Join from '../../components/Join.tsx';
import { createClient } from "../../db/supabase";
import Delete from '../../components/delete';
import { getAdventuresWithStatus } from '../../lib/utils/getAdventuresWithStatus';
import type { adventureWithStatus } from '../../lib/types';

const role = Astro.locals.userRole;

const supabase = createClient({
    request: Astro.request,
    cookies: Astro.cookies,
});

const adventures:adventureWithStatus[] = await getAdventuresWithStatus({
    request: Astro.request,
    cookies: Astro.cookies
})

console.log('adventures ok', adventures[0])
---
<Layout>
    <div class="w-full flex flex-col items-center justify-center gap-4 py-4">    
        <h1 class="flex gap-2 items-center text-2xl font-bold text-center mb-4">
            TABLERO DE MISIONES
            <i class="fa-solid fa-arrow-down-short-wide"></i>
        </h1>
        <section class="w-full flex flex-col md:flex-row items-center justify-center gap-4">
            {adventures.map((adventure: adventureWithStatus) => {

                const isFull =
                    adventure.currentPlayers >= adventure.max_players;

                return (
                        <article class="board shadow shadow-border">

                            <div class="flex items-center justify-center gap-2 mb-4">
                                <h2 class="text-2xl font-bold text-center underline">
                                <a href={`/adventures/league/${adventure.id}`} class="truncate">
                                        {adventure.title}
                                    </a>
                                </h2>
                                {
                                    (role === "admin" || role === "super_admin") && (
                                        <Delete id={adventure.id} client:only="react" />
                                    )
                                }
                            </div>

                            <img
                                src={adventure.poster_url ?? "/last-sanctum.png"}
                                alt={adventure.title}
                                class="mx-auto w-4/5 object-cover mb-4 rounded"
                            />

                            <Join
                                client:only="react"
                                role={adventure.role}
                                currentPlayers={adventure.currentPlayers}
                                currentSubstitutes={adventure.currentSubstitutes}
                                maxPlayers={adventure.max_players}
                                isRegistered={adventure.isRegistered}
                                adventureId={adventure.id}
                            />

                        </article>
                );
            })}   
        </section>
    </div>
</Layout>

<style>
    .board {
        position: relative;
        display: flex;
        flex-direction: column;
        width: 100%;
        min-height: 60vh;
        background-image: url('/wood-bg.jpg');
        background-size: cover;
        padding: 2rem;
        gap: 0.5rem;
        border-radius: 0.5rem;
        text-align: center;
    }
</style>