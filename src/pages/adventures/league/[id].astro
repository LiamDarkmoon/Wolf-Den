---
import Layout  from "../../../layouts/Layout.astro";
import { createClient } from "../../../db/supabase";

const { id } = Astro.params;

const supabase = createClient({
    request: Astro.request,
    cookies: Astro.cookies,
});

const { data: adventure, error } = await supabase
    .from('adventures')
    .select('*')
    .eq('id', id)
    .single()

---

<Layout>
    <section class="flex flex-col gap-2 text-center">
        <h1 class="text-2xl text-primary font-extrabold underline">{adventure.title}</h1>
        <a href="/adventures/league" class="text-xs text-secondary">Back</a>
        <p>{adventure.description}</p>
        <img
            src={adventure.poster_url ?? "/last-sanctum.png"}
            alt={adventure.title}
            class="mx-auto w-4/5 object-cover mb-4 rounded"
        />
    </section>
</Layout>
