---
import Layout from "../../../layouts/Layout.astro";
import { createClient } from "../../../db/supabase";
import CharacterSelector from "../../../components/CharacterSelector";
import type { Player } from "../../../lib/types";
import Delete from "../../../components/delete";
import { getAdventurePlayers } from "../../../lib/utils/getAdventurePlayers";

const { id } = Astro.params;

const user = Astro.locals.user;
const role = Astro.locals.userRole

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const { data: adventure } = await supabase
  .from("adventures")
  .select("*")
  .eq("id", id)
  .single();

const players = await getAdventurePlayers({
  request: Astro.request,
  cookies: Astro.cookies,
  id
});

const titulares = players.filter((player: Player) => player.role === "titular");

const suplentes = players.filter(
  (player: Player) => player.role === "suplente",
);
---

<Layout>
  <section class="w-full flex flex-col items-center text-center">
    <h1 class="flex gap-4 items-center text-2xl text-primary font-extrabold underline">
      <a href="/adventures/league" class="text-secondary"
        ><i class="fa-solid fa-arrow-left"></i></a
      >
      {adventure.title}
      {(id && role !== "user") && <Delete id={id} client:only="react"/>}
    </h1>
    <p class="my-4 md:w-1/2">{adventure.description}</p>
    <article class="w-full flex flex-col-reverse md:flex-row justify-around">
      <div class="flex flex-col md:w-1/3 p-4 gap-5 text-start">
        <ul class="min-h-25">
          <h2
            class="text-xl font-semibold border-b-2 border-primary text-primary"
          >
            Titulares
          </h2>

          {
            titulares.map((player: Player) => (
            <CharacterSelector
                userId={user?.id}
                player={player}
                adventureId={adventure.id}
                role={role}
                client:only="react"
              />
            ))
          }
        </ul>
        <ul class="min-h-25">
          <h2
            class="text-xl font-semibold border-b-2 border-primary text-primary"
          >
            Suplentes
          </h2>
          {
            suplentes.map((player: Player, index: number) => (  
            <CharacterSelector
                userId={user?.id}
                player={player}
                adventureId={adventure.id}
                substitute
                index={index +1}
                role={role}
                client:only="react"
              />
            ))
          }
        </ul>
      </div>

      <img
        src={adventure.poster_url ?? "/poster.jpeg"}
        alt={adventure.title}
        class="md:w-1/3 object-cover rounded-md"
      />
    </article>
  </section>
</Layout>
