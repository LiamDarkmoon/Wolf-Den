---
import Layout  from "../../../layouts/Layout.astro";
import { createClient } from "../../../db/supabase";
import CharacterSelector from "../../../components/CharacterSelector";

const { id } = Astro.params;

const user = Astro.locals.user;

const supabase = createClient({
    request: Astro.request,
    cookies: Astro.cookies,
});

const { data: adventure } = await supabase
    .from('adventures')
    .select('*')
    .eq('id', id)
    .single()

const { data: playersData, error: playersError } = await supabase.rpc(
    "get_adventure_players",
    {
        p_adventure_id: adventure.id,
    }
);

const players = playersData?.players ?? [];

const titulares = players.filter(
    (player) => player.role === "titular"
);

const suplentes = players.filter(
    (player) => player.role === "suplente"
);
---

<Layout>
    <section class="w-full flex flex-col items-center text-center">
        <h1 class="text-2xl text-primary font-extrabold underline">{adventure.title}</h1>
        <a href="/adventures/league" class="text-xs text-secondary mt-3">Back</a>
        <p class="my-4">{adventure.description}</p>
        <article class="w-full flex flex-col-reverse md:flex-row justify-around">

            <div class="flex flex-col md:w-1/3 p-4 gap-5 text-start   ">
                <ul class="relative">
                    <h2 class="text-xl font-semibold border-b-2 border-primary text-primary">Titulares</h2>
                    {titulares.map((player: any) => (
                        <li class="italic my-2">
                            <CharacterSelector userId={user?.id} player={player} adventureId={adventure.id} client:only="react"/>
                        </li>
                    ))}
                </ul>
                <ul>
                    <h2 class="text-xl font-semibold border-b-2 border-primary text-primary">Suplentes</h2>
                    {suplentes.map((player: any, index:number) => (
                        <li class="italic my-2">
                            <span class="text-xs opacity-50">
                                {index +1} - 
                            </span>
                            {player.display_name}
                            <span class="text-xs opacity-50">
                                ({player.user_id.slice(0, 6)})
                            </span>
                        </li>
                    ))}
                </ul>
            </div>

            <img
                src={adventure.poster_url ?? "/last-sanctum.png"}
                alt={adventure.title}
                class="md:w-1/2 object-cover rounded-md"
            />

        </article>
    </section>
</Layout>
