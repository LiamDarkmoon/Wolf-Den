---
import Admin from '../../layouts/Admin.astro';
import PlayersList from '../../components/PlayersList';
import { createClient } from "../../db/supabase";

const role = Astro.locals.userRole

const supabase = createClient({
    request: Astro.request,
    cookies: Astro.cookies,
});


const { data: players, error } = await supabase.rpc("get_all_players");

---
<Admin>
    <section class="flex flex-col md:flex-row  gap-5 py-4 w-full">
        
        <div class="md:w-2/5 flex flex-col  gap-4">
            <h2 class="text-3xl font-bold text-center border-b border-main-text">Administrar Jugadores</h2>
            <PlayersList role={role} players={players} client:only="react"/>
        </div>

        

    </section>
</Admin>
