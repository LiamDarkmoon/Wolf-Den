---
import Admin from '../../layouts/Admin.astro';



---
<Admin>
    <section class="flex  justify-center gap-4 py-4 w-full">
        
        <div class="w-2/5 flex flex-col md:items-center gap-4">
            <h2 class="text-2xl font-bold text-center border-b border-main-text">Aventuras</h2>
            <ul class="flex flex-col gap-2 p-2">
                <li class="text-lg text-center">Aventura 1</li>
                <li class="text-lg text-center">Aventura 2</li>
                <li class="text-lg text-center">Aventura 3</li>
            </ul>
        </div>
        
        <div class="w-2/5 flex flex-col md:items-center gap-4">
            <h2 class="text-2xl font-bold text-center border-b border-main-text">Jugadores</h2>
            <ul class="flex flex-col gap-2 p-2">
                <li class="text-lg text-center">Jugador 1</li>
                <li class="text-lg text-center">Jugador 2</li>
                <li class="text-lg text-center">Jugador 3</li>
            </ul>
        </div>

    </section>
</Admin>
