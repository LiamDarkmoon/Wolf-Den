---
import Layout from '../layouts/Layout.astro';

const user = Astro.locals.user;
const role = Astro.locals.userRole;

---
<Layout>
    <section class="flex flex-col items-center justify-center gap-4 py-4 w-full h-full">
        <h1 class="text-6xl font-black text-primary-hover text-center mb-5">404 - Page Not Found</h1>
        <p class="italic text-xl">Lo sentimos, estamos ocupados lidiando con algo. Por favor, vuelve más tarde.</p>
    </section>
</Layout>
