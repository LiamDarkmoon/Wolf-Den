---
import CharactersTable from '../../components/CharactersTable';
import AdventureList from '../../components/AdventuresList'
import { createClient } from "../../db/supabase";
import ProfileFrame from '../../components/ProfileFrame';
import Layout from '../../layouts/Layout.astro';
import avatar from '../../../public/avatar.jpg';
import type { registeredAdventure } from '../../lib/types'


const { id } = Astro.params;
const user = Astro.locals.user;
const role = Astro.locals.userRole;

const supabase = createClient({
    request: Astro.request,
    cookies: Astro.cookies,
});

const {
    data: characters,
    error,
} = await supabase
    .from("characters")
    .select("*")
    .order("created_at", {
        ascending: false,
    });

const { data, error: ad_error } = await supabase.rpc(
    "get_user_adventures"
);

const adventures = data?.adventures ?? [];

---
<Layout>
    <div class="flex flex-col items-center gap-4 py-4 w-full">
        <div>
            <div class="relative flex justify-center items-center">
                <ProfileFrame className="relative size-25 mx-auto text-primary"/>
                    <img
                        src={user ? user.user_metadata.picture : avatar.src}
                        alt="Profile Picture"
                        class="absolute w-15 rounded-full"
                    />
            </div>
            <div class="flex justify-center items-center gap-2">
                <h1 class="text-2xl font-bold">{user?.user_metadata?.full_name}</h1>
                <a href="/auth/logout" class="text-center text-secondary-text">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                    </svg>
                </a>
            </div>
        </div>
        
        <div class="flex flex-col md:flex-row md:justify-around w-full gap-5 p-4">
            <section class="flex flex-col gap-3">  
                <h2 class="flex gap-2 items-center text-xl font-bold underline text-center">
                    Personajes
                </h2>
                <CharactersTable characters={characters} client:only="react"/>
            </section>
            <section class="flex flex-col gap-3">  
                <h2 class="flex gap-2 items-center text-xl font-bold underline text-center">
                    Aventuras
                </h2>
                <AdventureList adventures={adventures} client:only="react"/>
            </section>
        </div>
    </div>
</Layout>