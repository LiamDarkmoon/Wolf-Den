---
import CharactersTable from "../../components/CharactersTable";
import AdventureList from "../../components/AdventuresList";
import { createClient } from "../../db/supabase";
import ProfileFrame from "../../components/ProfileFrame";
import Layout from "../../layouts/Layout.astro";
import avatar from "../../../public/avatar.jpg";
import type { registeredAdventure } from "../../lib/types";

const { id } = Astro.params;
const user = Astro.locals.user;
const role = Astro.locals.userRole;

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const { data: characters, error } = await supabase
  .from("characters")
  .select("*")
  .order("created_at", {
    ascending: false,
  });
  console.log("ch",characters)

const { data, error: ad_error } = await supabase.rpc("get_user_adventures");

const adventures = data?.adventures ?? [];
---

<Layout>
  <div class="flex flex-col items-center gap-4 py-4 w-full">
    <div>
      <div class="relative flex justify-center items-center">
        <ProfileFrame className="relative size-25 mx-auto text-primary" />
        <img
          src={user ? user.user_metadata.picture :null}
          alt="Profile Picture"
          class="absolute w-15 rounded-full"
        />
      </div>
      <h1 class="text-2xl font-bold">{user?.user_metadata?.full_name}</h1>
    </div>

    <div class="flex flex-col md:flex-row md:justify-around w-full gap-5 p-4">
      <section class="flex flex-col gap-3">
        <h2
          class="flex gap-2 items-center text-xl font-bold underline text-center"
        >
          Personajes
        </h2>
        {
            !characters || characters?.length > 0 ?
            <CharactersTable characters={characters} client:only="react" />
            : <a href="/characters/creation" class="flex gap-2 p-2 items-center font-black rounded-xl text-sm bg-primary hover:bg-primary-hover transition-all duration-300">Crea un Personaje</a>
        }
      </section>
      <section class="flex flex-col gap-3">
        <h2
          class="flex gap-2 items-center text-xl font-bold underline text-center"
        >
          Aventuras
        </h2>
        {
            !adventures || adventures.lenght > 0 ?
            <AdventureList adventures={adventures} client:only="react" />
            : <a href="/adventures/league" class="flex gap-2 p-2 items-center font-black rounded-xl text-sm bg-primary hover:bg-primary-hover transition-all duration-300">Unete a una aventura</a>
        }
      </section>
    </div>
  </div>
</Layout>
