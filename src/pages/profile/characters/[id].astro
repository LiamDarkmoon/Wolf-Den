---
import Layout from "../../../layouts/Layout.astro";
import Under from "../../../components/Under";
import { getCharacter } from "../../../lib/utils/getCharacter";
import type { AbilityCode } from "../../../lib/types";
import { getAbilityModifier } from "../../../lib/rules/abilities";

const { id } = Astro.params;
const user = Astro.locals.user;

const character = await getCharacter({
  request: Astro.request,
  cookies: Astro.cookies,
  id,
});

if (!character && user) {
  return Astro.redirect(`/profile/${user.id}`);
}

const abilityOrder: AbilityCode[] = ["STR", "DEX", "CON", "INT", "WIS", "CHA"];
---

<Layout>
  <section class="flex flex-col items-center w-full gap-3 p-2">
    <article
      class="flex flex-col items-center md:w-3/5 h-[75vh] p-6 gap-3 rounded-md scroll text-secondary-bg"
    >
      <h1 class="h-8 text-3xl font-black uppercase">{character?.name} | lvl: {character?.level}</h1>
      <div class="md:w-1/2 flex flex-col text-center gap-1">
        <span class=""> {character?.background.name}</span>
        <span class="italic"
          >{character?.species.name}({character?.species.variant?.name}) - {character?.class.name}(sub
          class)
        </span>
        <Under />
      </div>
      <div class="flex flex-wrap items-center justify-center gap-2">
        {
          Object.entries(character?.abilities)
            .sort(
              ([a], [b]) =>
                abilityOrder.indexOf(a as AbilityCode) -
                abilityOrder.indexOf(b as AbilityCode),
            )
            .map(([ability, score]) => (
              <div class="flex items-center justify-between w-35 md:w-1/4 h-12.5 p-2 border-y-4 border-secondary-bg">
                <span class="w-10 text-2xl font-semibold">{ability}:</span>

                <span class="text-2xl font-semibold">
                  {score}
                  <span class="text-sm italic">
                    ({getAbilityModifier(score) >= 0 ? "+" : ""}
                    {getAbilityModifier(score)})
                  </span>
                </span>
              </div>
            ))
        }
      </div>
    </article>
  </section>
</Layout>
