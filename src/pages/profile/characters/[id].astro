---
import Layout from "../../../layouts/Layout.astro";
import Under from "../../../components/Under";
import { getCharacter } from '../../../lib/utils/getCharacter'

const { id } = Astro.params;
const user = Astro.locals.user;

const character = await getCharacter({
    request: Astro.request,
    cookies: Astro.cookies,
    id
})

if (!character && user) {
    return Astro.redirect(`/profile/${user.id}`);
}

const abilityOrder = ["str", "dex", "con", "int", "wis", "cha"];
---

<Layout>
    <section class="flex flex-col items-center w-full gap-3 p-2 ">
        <article class='flex flex-col items-center justify-center md:w-1/2 p-5 gap-3 rounded-md scroll text-secondary-bg'>
            <h1 class="h-8 text-3xl font-black uppercase">{character.name}</h1>
            <div class="md:w-1/2 flex flex-col text-center gap-1">
                <span class=""> {character.background}</span>
                <span class="italic">{character.species}(sub spc) - {character.class}(sub class) </span>
                <Under/>
            </div>
            <div class="flex flex-wrap items-center justify-center gap-2">
                {
                
                    abilityOrder.map((key) => {
                        const value = character.abilities[key];
                        
                        return (<div class={`flex items-center justify-between w-35 md:w-1/4 h-12.5 p-2 border-y-4 border-secondary-bg`}>
                            <span class="w-10 text-2xl font-semibold">{key.toUpperCase()}:</span>
                            <span class="text-2xl font-semibold"> {value}</span>
                        </div>)
                })}
            </div>
        </article>
    </section>
</Layout>
